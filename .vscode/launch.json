{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug vsgviewer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/vsgviewer",
            "args": ["~/dev/guiTestData/12140_Skull_v3_L2.obj", "--nf"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":99"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true
            }
        }
    ]
}